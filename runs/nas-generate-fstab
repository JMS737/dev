#!/usr/bin/env bash

if [ ! -d /nas ]; then
  mkdir /nas
fi

if [ -z $1 ]; then
  echo "Usage 'nas-fstab <hostname>'"
  exit
fi

HOST=$1
CRED_DIR=$XDG_DATA_HOME/nas
CRED_FILE=$CRED_DIR/smb-credentials

echo "
//$HOST/vault /nas/vault cifs defaults,credentials=$CRED_FILE,uid=$UID,x-systemd.automount,x-systemd.requires=tailscaled.service,x-systemd.idle-timeout=60,x-systemd.mount-timeout=30
//$HOST/scratch /nas/scratch cifs defaults,credentials=$CRED_FILE,uid=$UID,x-systemd.automount,x-systemd.requires=tailscaled.service,x-systemd.idle-timeout=60,x-systemd.mount-timeout=30
//$HOST/media /nas/media cifs defaults,credentials=$CRED_FILE,uid=$UID,x-systemd.automount,x-systemd.requires=tailscaled.service,x-systemd.idle-timeout=60,x-systemd.mount-timeout=30
//$HOST/shared /nas/shared cifs defaults,credentials=$CRED_FILE,uid=$UID,x-systemd.automount,x-systemd.requires=tailscaled.service,x-systemd.idle-timeout=60,x-systemd.mount-timeout=30
//$HOST/games /nas/games cifs defaults,credentials=$CRED_FILE,uid=$UID,x-systemd.automount,x-systemd.requires=tailscaled.service,x-systemd.idle-timeout=60,x-systemd.mount-timeout=30
//$HOST/archives /nas/archives cifs defaults,credentials=$CRED_FILE,uid=$UID,x-systemd.automount,x-systemd.requires=tailscaled.service,x-systemd.idle-timeout=60,x-systemd.mount-timeout=30

"
